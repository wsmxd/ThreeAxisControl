# ==========================================================
#  STM32F407 Project .gitignore
#  适用:STM32CubeIDE / Keil MDK / IAR EWARM / CLion+CMake
#  原则:忽略"可再生的构建产物 + 本机/用户级配置",
#        保留"源文件 + 工程文件 + .ioc + 启动文件 + 链接脚本"
# ==========================================================

# ---------- 通用编译产物 ----------
*.o
*.obj
*.a
*.lib
*.elf
*.axf
*.bin
*.hex
*.s19
*.map
*.lst
*.sym
*.su
*.d
*.crf
*.dep
*.lnp
*.htm
*.iex
*.sct
*.ld              # 注意:若为手写链接脚本(如 STM32F407VGTx_FLASH.ld),见下文"不要忽略"
*.build_log.htm

# 构建目录(CubeIDE 默认 Debug/ Release/,CLion 默认 build/ cmake-build-*/)
Debug/
Release/
build/
cmake-build-*/
out/
.gradle/

# ---------- STM32CubeIDE(Eclipse CDT) ----------
.settings/
.metadata/
*.launch
*.cproject.bak
*.project.bak
*.prefs
RemoteSystemsTempFiles/
.cache/
*.log
*.trc
*.trace

# ---------- Keil MDK (uVision) ----------
*.uvguix.*          # 每个用户的窗口布局,不应该提交
*.uvoptx            # 用户选项(调试器、断点),本机相关
*.uvopt
*.scvd
JLinkLog.txt
JLinkSettings.ini
EventRecorderStub.scvd
Listings/
Objects/
RTE/_*/            # RTE 按 target 生成的临时内容,但保留 RTE/_<target>/ 需视工程而定

# ---------- IAR EWARM ----------
*.ewt
*.ewp.bak
*.eww
*.dep
settings/
*.dni
*.wsdt
*.wspos
*.dbgdt

# ---------- CLion / JetBrains ----------
.idea/
*.iml
cmake-build-*/
CMakeUserPresets.json
cmake-build-debug/
cmake-build-release/

# ---------- VS Code ----------
.vscode/
!.vscode/launch.json      # 团队共享的调试配置可选择性保留
!.vscode/tasks.json

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.vscode/.browse.*.db
.eide/
*.log

# ---------- 备份 / 临时 ----------
*.bak
*.orig
*.rej
*.tmp
*.~*
*.autosave

# ---------- 包管理 / 环境 ----------
venv/
.venv/
env/
*.pyc
__pycache__/

# ---------- STM32CubeMX 生成但可忽略的中间文件 ----------
*.mxproject.bak
*.mxproject.orig